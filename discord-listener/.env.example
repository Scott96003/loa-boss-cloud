# Discord 個人帳號 Token (請參閱 README.md 獲取方式)
DISCORD_USER_TOKEN="your_discord_user_token_here"

# 監聽的目標頻道 ID (預設為天堂擊殺頻道)
TARGET_CHANNEL_ID="1527172467016335493"

# 第二步建立的 Cloudflare Worker API 網址
# 本地測試可用: http://localhost:8787/api/boss-death
# 雲端部署後填寫 Worker 網址: https://loa-boss-worker.<你的子網域>.workers.dev/api/boss-death
WORKER_API_URL="http://localhost:8787/api/boss-death"

# 觸發解析的關鍵字
KEYWORD="LoA363 頭目擊殺記錄 Boss Kills"
